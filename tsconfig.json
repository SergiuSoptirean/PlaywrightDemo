{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "es2020",
    "lib": ["ES2023", "DOM"],
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false
  },
  "include": ["**/*.ts"],
  "exclude": ["dist"]
}
